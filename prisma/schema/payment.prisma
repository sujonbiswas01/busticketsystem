model Payment {
  id String @id @default(uuid())
  booking_id     String @unique
  transaction_id String
  amount         BigInt
  payment_status PaymentStatus @default(PENDING)
  created_at     DateTime      @default(now())
  user_id        String
  stripeEventId String? @unique
  transactionId String? @unique @db.Uuid()
  paymentGatewayData Json?
  bus_id  String @unique

  user  User  @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Cascade)

  booking Booking @relation(fields: [booking_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
    bus Bus @relation(fields: [bus_id], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@map("payments")
}

