model Booking {
    id             String        @id @default(uuid())
    user_id        String
    schedule_id    String
    total_price    Int
    booking_status BookingStatus @default(PENDING)
    payment_status PaymentStatus @default(PENDING)
    created_at     DateTime      @default(now()) @db.Date
    user           User          @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
    Bookingseats   Bookingseat[]
    payment        Payment?

    @@map("bookings")
}

model Bookingseat {
    id         String  @id @default(uuid())
    seat_id    String
    booking_id String
    created_at DateTime @default(now())
    seat       Seat    @relation(fields: [seat_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
    booking    Booking @relation(fields: [booking_id], references: [id], onDelete: Cascade, onUpdate: Cascade)
    @@map("bookingseats")
}
